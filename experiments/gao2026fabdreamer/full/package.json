{
  "name": "system-x",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-contour": "^4.0.3",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "simplify-js": "^1.2.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
