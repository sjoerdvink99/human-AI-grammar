{
  "name": "system-x",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "walkthrough": "node scripts/walkthrough.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
