{
  "name": "system-x",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.4",
    "express": "^5.3.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6"
  }
}
